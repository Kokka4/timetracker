{
  "manifest_version": 3,
  "name": "Local Time Tracker Bridge",
  "version": "1.1.0",
  "description": "Reports the active tab to your own time tracker on 127.0.0.1. Nothing is sent anywhere else.",

  "permissions": ["tabs", "webNavigation", "idle", "alarms", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Local Time Tracker"
  },

  "minimum_chrome_version": "116"
}
